      "credentials": {
        "gmailOAuth2": {
          "id": "Dxoft7j31RrYkV5w",
          "name": "Gmail account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COUNT(*) AS total_anomalies,\n    COUNT(*) FILTER (\n        WHERE detected_at >= TIMESTAMPTZ\n        '2026-10-31 00:00:00 America/Chicago'\n    ) AS after_cutoff,\n    MIN(detected_at) AS earliest_detection,\n    MAX(detected_at) AS latest_detection\nFROM public.detected_anomalies;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1408,
        -416
      ],
      "id": "6634c99f-bbc6-49bc-9697-58c4c930a56a",
      "name": "Execute a SQL query1",
      "credentials": {
        "postgres": {
          "id": "cqeR5XAfo0iCWAIW",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.anomaly_alerts\nSET email_claimed_at = NOW()\nWHERE transaction_id = $1\n  AND email_sent = FALSE\n  AND email_claimed_at IS NULL\nRETURNING\n    transaction_id,\n    alert_type,\n    amount,\n    anomaly_score,\n    ai_explanation,\n    email_sent;",
        "options": {
          "queryReplacement": "={{ [ $json.transaction_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1328,
        64
      ],
      "id": "1212d4f6-9b25-419b-aff8-e00a5bbc7cca",
      "name": "Execute a SQL query2",
      "credentials": {
        "postgres": {
          "id": "cqeR5XAfo0iCWAIW",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n    UPDATE public.anomaly_alerts\n    SET email_sent = TRUE,\n        notification_error = NULL\n    WHERE transaction_id = $1\n      AND email_sent = FALSE\n      AND email_claimed_at IS NOT NULL\n    RETURNING transaction_id\n)\nSELECT\n    COUNT(*)::integer AS updated_count,\n    MAX(transaction_id) AS updated_transaction_id\nFROM updated;",
        "options": {
          "queryReplacement": "={{ [ $('Execute a SQL query2').item.json.transaction_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
