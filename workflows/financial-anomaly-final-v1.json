    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    d.transaction_id,\n    d.amount,\n    d.transaction_hour,\n    d.anomaly_score\nFROM detected_anomalies AS d\nLEFT JOIN anomaly_alerts AS a\n    ON d.transaction_id = a.transaction_id\nWHERE a.transaction_id IS NULL\nORDER BY d.anomaly_score DESC\nLIMIT 2;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        176,
        80
      ],
