          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.anomaly_alerts\nSET notification_error = $2\nWHERE transaction_id = $1\n  AND email_sent = FALSE\n  AND email_claimed_at IS NOT NULL\nRETURNING transaction_id, notification_error;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{\n  [\n    $('Execute a SQL query2').item.json.transaction_id,\n    $json.error?.message || $json.message || 'Gmail delivery failed \u2014 review before retrying'\n  ]\n}}"
