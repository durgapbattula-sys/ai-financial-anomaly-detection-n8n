        "subject": "={{ \"Financial Anomaly Alert - \" + $json.transaction_id }}",
        "emailType": "text",
        "message": "={{ `FINANCIAL TRANSACTION ANOMALY ALERT  Transaction ID: ${$json.transaction_id}  Amount: $${$json.amount}  Anomaly Score: ${$json.anomaly_score}  AI Explanation: ${$json.ai_explanation}  This transaction was flagged for review by the anomaly detection pipeline.  Generated by n8n + Python + Isolation Forest + Ollama.` }}",
